# ============================================================
# Private Chat — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/privatechat

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Environment: development | production
ENVIRONMENT=development
